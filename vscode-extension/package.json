{
  "name": "query-oracle",
  "displayName": "Query Oracle — LLM Router",
  "description": "Auto-routes questions to the optimal LLM (Haiku→Opus, GPT-4o-mini→o1, Gemini Flash→Thinking) based on query complexity. No manual model selection.",
  "version": "1.0.0",
  "publisher": "phadvas-industries",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hemanpadvas2002/query-oracle"
  },
  "bugs": {
    "url": "https://github.com/hemanpadvas2002/query-oracle/issues"
  },
  "keywords": ["llm", "ai", "routing", "claude", "openai", "gemini", "copilot"],
  "categories": ["AI", "Other"],
  "engines": { "vscode": "^1.85.0" },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "llmRouter.ask",
        "title": "LLM Router: Ask (auto-route)"
      },
      {
        "command": "llmRouter.classify",
        "title": "LLM Router: Classify query"
      },
      {
        "command": "llmRouter.askSelection",
        "title": "LLM Router: Ask with selected text"
      }
    ],
    "keybindings": [
      {
        "command": "llmRouter.ask",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      }
    ],
    "configuration": {
      "title": "LLM Query Router",
      "properties": {
        "llmRouter.apiUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "REST API URL. Change only if you run the server on a different port or host."
        },
        "llmRouter.defaultProvider": {
          "type": "string",
          "enum": ["anthropic", "openai", "gemini"],
          "default": "anthropic",
          "description": "Default LLM provider (needs the matching API key in env)."
        },
        "llmRouter.showRoutingMetadata": {
          "type": "boolean",
          "default": true,
          "description": "Show tier / model / latency / cost above each response."
        },
        "llmRouter.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the REST server if it is not already running."
        },
        "llmRouter.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used to start the server (e.g. 'python3' or an absolute path to a venv)."
        },
        "llmRouter.serverPort": {
          "type": "number",
          "default": 8000,
          "description": "Port for the auto-started REST server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "compile": "npm run esbuild-base -- --sourcemap",
    "watch": "npm run esbuild-base -- --sourcemap --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
